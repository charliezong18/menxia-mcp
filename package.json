{
  "name": "menxia-mcp",
  "version": "0.1.0",
  "description": "Agent-side MCP server for menxia — the annotation desk.",
  "license": "MIT",
  "author": "Charlie Zong",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charliezong18/menxia-mcp.git"
  },
  "homepage": "https://github.com/charliezong18/menxia-mcp#readme",
  "bugs": {
    "url": "https://github.com/charliezong18/menxia-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "sh -c 'tsc && vitest run && node scripts/print-milestones.mjs; rc=$?; node scripts/print-parity.mjs; node scripts/retire-gate.mjs || true; exit $rc'",
    "test:watch": "vitest",
    "acceptance": "npm run build && node scripts/acceptance.mjs && node scripts/lint-differential.mjs",
    "diagrams": "./render-diagrams.sh",
    "differential": "npm run build && node scripts/lint-differential.mjs",
    "retire-gate": "npm run build && node scripts/retire-gate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/rest": "^21.0.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
