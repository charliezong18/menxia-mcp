#!/usr/bin/env bash
# 旧词闸门：7/31 已废的唐制前旧词不许再进仓。
#
# 这个 hook **只管用词**，不跑测试——测试请照旧 npm test。将来要不要把 vitest 也挂上来
# 是另一个决策，别因为「有 pre-push」就以为代码被保护了。
#
# 启用（clone 走的人做一次）：git config core.hooksPath .githooks
# 逃生门：git push --no-verify
#
# 病史：7/31 唐制改名的脚本（menxia 仓 tang-rename.py）把「档案文档」整体排除，规矩写的是
# 「档案不追改，历史该留着旧称」——被读成整份文档都别动。两个仓合计几百处旧词就这么活了
# 六天，直到 2026-08-06 Charlie 在 GitHub 上读 PAIN.md 读懵才发现。当时没有任何东西在拦。
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# 排除区。这个仓跟 menxia 不同：旧词里有一整块是**数据契约**，不是用词，改了静默失效。
#   src/threads.ts        DESK_MARK = /^(门下|御笔朱批)/ —— GitHub 上 #1–#52 的 review
#                         body 里存的就是旧串，死数据，新旧必须并存
#   test/threads.test.ts  专门守上面那条的用例（含 :540「仍认旧串」）
#   test/fixtures/        真实 PR 的历史快照
#   MILESTONES / design   正文引用那串协议常量，以及当时那条误伤命令的原文
#   scripts/acceptance    /没有这些总批/ 匹配的是运行时文案，不能跟着文档改
#   .githooks/pre-push    本文件自己：下面 LEGACY_RE 的定义就是一串旧词（menxia 那边实测
#                         撞到过，不排除就自己咬自己）
LEGACY_SKIP=(':(exclude).githooks/pre-push' ':(exclude)src/threads.ts'
             ':(exclude)test/threads.test.ts' ':(exclude)test/fixtures/'
             ':(exclude)MILESTONES.md' ':(exclude)MILESTONES.zh-CN.md'
             ':(exclude)docs/phase-1/design.md' ':(exclude)docs/phase-1/design.zh-CN.md'
             ':(exclude)scripts/acceptance.mjs')

# 基准取自「推去哪」：git 从 stdin 逐行喂 <本地ref> <本地sha> <远端ref> <远端sha>。
# 拿当前分支名去猜同名远端分支的写法，在 `git push origin HEAD:main` 这种源≠分支名的
# 推送上必猜错（menxia 2026-08-02 实伤）。算不出增量就扫全仓：只许往严的方向倒。
is_zero() { [[ "$1" =~ ^0+$ ]]; }
ADDED=""
NREF=0
WIDEN=0
while read -r _lref lsha _rref rsha; do
  [ -z "${lsha:-}" ] && continue
  is_zero "$lsha" && continue                        # 删远端分支：没内容可查
  NREF=$((NREF + 1))
  if ! is_zero "$rsha" && git cat-file -e "${rsha}^{commit}" 2>/dev/null; then
    ADDED+="$(git diff "$rsha" "$lsha" -- . "${LEGACY_SKIP[@]}" | grep '^+' || true)"$'\n'
  else
    WIDEN=1
  fi
done

echo "── 旧词闸门 ──"
LEGACY_RE='朱批|奏折|钦此|总批|待批|御笔'
# 同一行标注了「这是旧词」就放行——记历史该留原措辞，只要读者不会当成现役词
LEGACY_OK='旧词|legacy term|原文存档|original text preserved|存账|存拍板|改成定稿词|已改|changed 7/31|改名时漏改|唐制统一|Tang-dynasty terms|协议常量|死数据'
if [ "$NREF" -eq 0 ] || [ "$WIDEN" -eq 1 ]; then
  echo "  算不出本次增量，改扫全仓"
  HITS="$(git grep -nE "$LEGACY_RE" HEAD -- . "${LEGACY_SKIP[@]}" 2>/dev/null | grep -vE "$LEGACY_OK" || true)"
else
  HITS="$(printf '%s' "$ADDED" | grep -E "$LEGACY_RE" | grep -vE "$LEGACY_OK" || true)"
fi

if [ -n "$HITS" ]; then
  echo "✖ 新增内容里有 7/31 已废的旧词，push 中止："
  printf '%s\n' "$HITS" | head -12 | sed 's/^/    /'
  echo "  现役词：门下 · 敕草 · 涂归 · 判 · 画可 · 待审"
  echo "  真要记历史（当时屏幕上是哪几个字、GitHub 上存的是哪串），"
  echo "  同一行写上「旧词」或「协议常量」即放行。"
  echo "  确要推：git push --no-verify"
  exit 1
fi
echo "✔ 旧词闸门通过"
